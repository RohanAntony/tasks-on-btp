{
  "welcomeFile": "/saptasks/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/odata/(.*)$",
      "destination": "srv-api",
      "authenticationType": "ias"
    },
    {
      "source": "^/saptasks/(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "ias"
    },
    {
      "source": "^(.*)$",
      "target": "/saptasks$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "ias"
    }
  ]
}
